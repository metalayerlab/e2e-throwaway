# e2e-throwaway. Install to /etc/systemd/system/e2e-throwaway.service; see the
# wiki's Deployment page (systemd). Template-owned skeleton: loosen the sandbox
# only with a comment saying why.
#
#   install -Dm644 contrib/systemd/e2e-throwaway.sysusers /usr/lib/sysusers.d/e2e-throwaway.conf
#   systemd-sysusers
#   UV_PYTHON_INSTALL_DIR=/opt/uv-python uv venv /opt/e2e-throwaway
#   uv pip install --python /opt/e2e-throwaway e2e-throwaway   # or the wheel from a release
#   install -Dm644 contrib/systemd/e2e-throwaway.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now e2e-throwaway
#
# ProtectHome= hides /root and /home, so the venv and its Python must live
# outside them (hence UV_PYTHON_INSTALL_DIR above).
[Unit]
Description=e2e-throwaway: Throwaway end-to-end test of project-template
Documentation=https://github.com/metalayerlab/e2e-throwaway/wiki
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=e2e-throwaway
Group=e2e-throwaway
ExecStart=/opt/e2e-throwaway/bin/e2e-throwaway serve -c /etc/e2e-throwaway/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=TZ=Europe/London

# /var/lib/e2e-throwaway, the config's default state_dir
StateDirectory=e2e-throwaway
StateDirectoryMode=0700
ConfigurationDirectory=e2e-throwaway
UMask=0077

# Sandboxing: it serves HTTP on a TCP port and writes only its state.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
